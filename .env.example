# ─── Orbit configuration ────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit the filled `.env`.
# Every secret below must be different between development and production.

# ─── Discord ────────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_BOT_TOKEN=
# Application ID from the same page (General Information)
DISCORD_APPLICATION_ID=
# Public key (only needed when running interactions over the HTTP webhook mode)
DISCORD_PUBLIC_KEY=

# ─── Database (docker compose) ──────────────────────────────────────────────────
# Compose creates the "orbit" database and a dedicated NOSUPERUSER application
# role on first boot (docker/postgres-init/01-orbit-app-role.sh). The app must
# never connect as a superuser: superusers bypass row level security entirely.
POSTGRES_DB=orbit
# postgres superuser password (host-side admin + backup scripts).
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=
# password for the "orbit" application role; compose wires DATABASE_URL itself.
# Generate with: openssl rand -hex 16
POSTGRES_APP_PASSWORD=
# Bare metal only (the compose app container overrides this value):
DATABASE_URL=postgresql://orbit:CHANGE_ME@localhost:5432/orbit

# ─── GitHub integration (GitHub App preferred) ──────────────────────────────────
# => https://github.com/settings/apps/new  (create a GitHub App, install it on repos)
GITHUB_APP_ID=
# PEM contents may be supplied directly OR via a mounted file path.
# Convention: keep the generated .pem at secrets/github-app-key.pem; the
# compose stack mounts ./secrets read-only at /run/secrets
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# public slug of the app (github.com/apps/<slug>); lets /project add render
# the one click installation URL for server admins
GITHUB_APP_SLUG=
# The secret you set in the GitHub App "Webhook secret" field
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_PATH=/api/webhooks/github

# ─── pgAdmin (DB visualization, optional) ──────────────────────────────────────
# http://127.0.0.1:5050 once `docker compose up -d` runs. The Orbit database
# is pre-registered; log in with these values (placeholders in this example).
# NOTE: PGADMIN_EMAIL must be a real domain address; reserved names (*.local)
# fail pgAdmin's boot validation
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ─── Webhook / public endpoint ──────────────────────────────────────────────────
# The public HTTPS address GitHub and your team reach this server on, without
# a trailing slash, e.g. https://orbit.example.com. Used when configuring the
# GitHub App (see docs/production-guide.md): webhook URL becomes
#   $PUBLIC_WEBHOOK_URL/api/webhooks/github
PUBLIC_WEBHOOK_URL=https://orbit.example.com
# Cloudflare tunnel token (Zero Trust dashboard). With a token set the
# compose "tunnel" profile serves app:3000 with zero open ports:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
# Port the HTTP server listens on inside the container
PORT=3000
# Bearer token shared with the admin API (/api/admin/*). Generate with:
#   openssl rand -hex 32
ADMIN_API_TOKEN=

# ─── AI (optional; Orbit is fully functional without it) ────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Monthly request budget from the AI layer (hard stop when exceeded)
AI_MONTHLY_REQUEST_BUDGET=2000

# ─── Operational ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Deployment-wide default timezone for every display, digest and reminder.
# IST-first: Asia/Kolkata. Any IANA name works; per-guild overrides supported.
DEFAULT_TIMEZONE=Asia/Kolkata
# Source sync cadence in minutes (per-source overrides exist in the DB).
# 420 = every 7 hours = 3-4 syncs per day for hackathon sources.
SYNC_INTERVAL_MINUTES=420
# Set to 0 to skip slash-command registration on boot
DISCORD_REGISTER_COMMANDS=1
# Retention (days) for logs of events before cleanup
RETENTION_DAYS=90
# 32-byte base64 key used to encrypt credentials stored in the database.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ─── External integrations ──────────────────────────────────────────────────────
# Bearer token for machine integrations: GET /api/integrations/health and
# GET /api/integrations/logs. Generate with: openssl rand -hex 32
INTEGRATION_API_TOKEN=
